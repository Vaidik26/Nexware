# =============================================================================
# Environment Variables & Secrets (NEVER COMMIT THESE)
# This section covers ALL .env files at every directory depth.
# =============================================================================
.env
.env.local
.env.*.local
.env.development
.env.production
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
*.env
*.env.bak
**/*.env.bak

# Preserve template files
!.env.example
!**/.env.example

# =============================================================================
# Python / FastAPI Backend
# =============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/

# Alembic
alembic.ini.bak
backend/alembic/versions/*.pyc

